# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment files
.env
.env.*
!.env.example

# Model caches & logs
*.log
.pytest_cache/
# Static runtime media uploads and studio outputs
static/raw/*
!static/raw/.gitkeep

static/studio/*
!static/studio/.gitkeep
