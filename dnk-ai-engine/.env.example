# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Multimodal Model (gemini-3.6-flash recommended)
GEMINI_MODEL=gemini-3.6-flash

# Qdrant Vector Engine Configuration (Optional: built-in vector search active if offline)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false
HS_CODE_COLLECTION_NAME=itc_hs_codes
VECTOR_DIMENSION=384