{
  "expo": {
    "name": "DNK Artisan",
    "slug": "dnk-artisan-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dnk-artisan",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B2222"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.in.dnk.artisan"
    },
    "android": {
      "package": "gov.in.dnk.artisan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#8B2222"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DNK Artisan to access your camera to capture craft photos for AI enhancement."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow DNK Artisan to record your voice note in your native language for cataloging."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DNK Artisan to detect your location to find the 5 nearest Dak Ghar Niryat Kendras."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
