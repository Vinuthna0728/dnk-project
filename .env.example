# =================================================================
# DAK GHAR NIRYAT KENDRA (DNK) - MASTER ENVIRONMENT CONFIGURATION
# =================================================================
# Copy the relevant sections into the respective service directories:
# 1. dak-ghar-backend/.env
# 2. dnk-ai-engine/.env
# 3. DNK/dnk-buyer-storefront/.env.local
# 4. DNK/dnk-artisan-app/.env
# =================================================================

# -----------------------------------------------------------------
# 1. CORE BACKEND API (dak-ghar-backend/.env)
# -----------------------------------------------------------------
# PostgreSQL connection URL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dak_ghar

# Secret key for JWT session tokens (generate a 256-bit secure secret)
SECRET_KEY=your_secure_jwt_secret_key_here

# Microservice endpoint of the AI Engine
AI_ENGINE_URL=http://127.0.0.1:8001

# Stripe Secret Key for Test Payments (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_key

# -----------------------------------------------------------------
# 2. DNK AI ENGINE (dnk-ai-engine/.env)
# -----------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (gemini-3.6-flash recommended for multimodal speech + vision)
GEMINI_MODEL=gemini-3.6-flash

# Qdrant Vector DB Configuration (Optional - fallback vector engine active if offline)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false
HS_CODE_COLLECTION_NAME=itc_hs_codes
VECTOR_DIMENSION=384

# -----------------------------------------------------------------
# 3. BUYER STOREFRONT (DNK/dnk-buyer-storefront/.env.local)
# -----------------------------------------------------------------
# Core Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------
# 4. ARTISAN EXPO APP (DNK/dnk-artisan-app/.env)
# -----------------------------------------------------------------
# Core Backend API Base URL
EXPO_PUBLIC_API_URL=http://localhost:8000